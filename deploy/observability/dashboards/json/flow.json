{
  "uid": "freightline-flow",
  "title": "Freightline / Flow",
  "tags": [
    "freightline",
    "p04",
    "flow"
  ],
  "description": "How an order moves through Freightline. P04-lite has no Kafka (D-01a): the spec's outbox backlog age, consumer lag and DLQ depth are replaced by the synchronous reservation path (adapted).",
  "editable": false,
  "schemaVersion": 41,
  "version": 1,
  "timezone": "utc",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": [
      {
        "name": "Rollouts",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "iconColor": "purple",
        "expr": "count by (job, freightline_pod_template_hash, service_version) (target_info{job=~\"freightline/.*\"}) unless count by (job, freightline_pod_template_hash, service_version) (target_info{job=~\"freightline/.*\"} offset 2m)",
        "step": "30s",
        "titleFormat": "rollout {{job}}",
        "textFormat": "version {{service_version}}, pod-template-hash {{freightline_pod_template_hash}}",
        "tagKeys": "job"
      }
    ]
  },
  "panels": [
    {
      "type": "text",
      "title": "About this dashboard (P04-lite adaptation)",
      "options": {
        "mode": "markdown",
        "content": "Full Freightline (P02) publishes events through a transactional outbox to Kafka; this dashboard would show **outbox backlog age, consumer lag and DLQ depth**. P04-lite reserves stock with a synchronous HTTP call (DEVIATIONS D-01a), so those panels are replaced by **order outcomes, reservation results, precheck degradations and database latency**, plus Tempo's service graph, which is the same in both."
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      }
    },
    {
      "type": "row",
      "title": "Order outcomes",
      "id": 2,
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Orders by final status (from logs)",
      "description": "LogQL metric over the orders JSON log line. REJECTED = out of stock; PENDING = inventory was slow or down.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (status) (count_over_time({service_name=\"orders\"} | json | msg=\"order accepted\" | replay=\"false\" [$__auto]))",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "fillOpacity": 10,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 3,
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Reservation results (inventory)",
      "description": "201 reserved, 200 replayed, 409 out of stock, 503 database pool exhausted (the P04 incident, M8).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (http_response_status_code) (rate(http_server_request_duration_seconds_count{job=\"freightline/inventory\", http_route=\"/v1/reservations\"}[$__rate_interval]))",
          "legendFormat": "{{http_response_status_code}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "fillOpacity": 10,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 4,
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Precheck degraded (orders could not reach inventory in 300 ms)",
      "description": "Orders accepted as PENDING because inventory was slow or down: early warning for the M8 game day.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({service_name=\"orders\"} |= \"inventory precheck degraded\" [$__auto]))",
          "legendFormat": "degraded"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 5,
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "DB pool exhausted (inventory 503s)",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({service_name=\"inventory\"} |= \"db pool exhausted\" [$__auto]))",
          "legendFormat": "pool exhausted"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 6,
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "row",
      "title": "Latency along the path (Tempo span metrics)",
      "id": 7,
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "p99 by span (server, client, database)",
      "description": "From Tempo's metrics-generator: every span, including SQL statements, with exemplars back to traces.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (service, span_name, le) (rate(traces_spanmetrics_latency_bucket{service=~\"orders|inventory\"}[$__rate_interval])))",
          "legendFormat": "{{service}} {{span_name}}",
          "exemplar": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 8,
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 24,
        "h": 8
      }
    },
    {
      "type": "row",
      "title": "Service graph",
      "id": 9,
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "nodeGraph",
      "title": "orders -> inventory -> postgres (Tempo service graph)",
      "description": "Edges from client/server span pairs (traces_service_graph_*); click a node for its RED and traces.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "serviceMap"
        }
      ],
      "id": 10,
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 24,
        "h": 12
      }
    }
  ]
}
